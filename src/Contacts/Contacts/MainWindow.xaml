<Window
    x:Class="Contacts.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Contacts"
    Width="613"
    Height="400"
    Icon="Resources/Contacts.jpg">

    <Grid>
        <!-- Определение колонок -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="3" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <!-- Левая панель -->
        <Grid Grid.Column="0" Background="#f8f8f8">
            <Border Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Поисковая строка -->
                    <Grid Grid.Row="0" Margin="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" VerticalAlignment="Center" Content="Find:" />
                        <TextBox
                            Grid.Column="1"
                            Height="20"
                            Margin="3 0 0 0"
                            IsReadOnly="True"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Stretch" />
                    </Grid>

                    <!-- Список контактов -->
                    <DataGrid
                        x:Name="ContactsGrid"
                        Grid.Row="1"
                        Margin="3 7 3 3"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        ItemsSource="{Binding Contacts}"
                        SelectedItem="{Binding SelectedContact}" />

                    <!-- Кнопки управления -->
                    <Grid Grid.Row="2" Margin="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            Grid.Column="0"
                            Height="25"
                            Margin="3"
                            Content="Add"
                            Command="{Binding AddCommand}" />
                        <Button
                            Grid.Column="1"
                            Height="25"
                            Margin="3"
                            Content="Edit"
                            Command="{Binding EditCommand}" />
                        <Button
                            Grid.Column="2"
                            Height="25"
                            Margin="3"
                            Content="Remove"
                            Command="{Binding RemoveCommand}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Разделитель -->
        <GridSplitter
            Grid.Column="1"
            Width="3"
            Background="White"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            ResizeBehavior="PreviousAndNext"
            ResizeDirection="Columns" />

        <!-- Правая панель -->
        <Grid Grid.Column="2" Background="White">
            <Border Margin="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Фото -->
                    <Image
                        Grid.Row="0"
                        Grid.RowSpan="3"
                        Grid.Column="0"
                        Width="100"
                        Height="100"
                        Margin="1,24,7,28"
                        Source="Resources/photo_placeholder_100x100.jpg" />

                    <!-- Имя -->
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="3">
                        <TextBlock Text="Name:" />
                        <TextBox
                            Margin="0 3 0 0"
                            IsReadOnly="{Binding IsReadOnly}"
                            Text="{Binding SelectedContact.Name, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <!-- Телефон -->
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="3">
                        <TextBlock Text="Phone Number:" />
                        <TextBox
                            Margin="0 3 0 0"
                            IsReadOnly="{Binding IsReadOnly}"
                            Text="{Binding SelectedContact.PhoneNumber, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <!-- Email -->
                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="3">
                        <TextBlock Text="Email:" />
                        <TextBox
                            Margin="0 3 0 0"
                            IsReadOnly="{Binding IsReadOnly}"
                            Text="{Binding SelectedContact.Email, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <!-- Кнопка Apply -->
                    <Button
                        Grid.Row="3"
                        Grid.Column="1"
                        Width="75"
                        Height="25"
                        Margin="0 50 0 0"
                        HorizontalAlignment="Left"
                        Content="Apply"
                        Visibility="{Binding ApplyButtonVisibility}"
                        Command="{Binding ApplyCommand}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
